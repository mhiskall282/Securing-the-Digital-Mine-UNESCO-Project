# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebooks
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Project specific ignores
# Ignore raw datasets
data/raw/*
!data/raw/.gitkeep

# Ignore large numpy arrays in data/processed but track scalers and label encoders
data/processed/*.npy
!data/processed/.gitkeep
!data/processed/*.pkl

# Ignore large numpy arrays in data/features but track feature metadata and masks
data/features/X_*.npy
!data/features/.gitkeep
!data/features/*.json
!data/features/nslkdd_bwoa_mask*.npy

# Models are tracked for academic reproducibility and collaborator access

logs/*
!logs/.gitkeep
!logs/README.md

# Scratch / temporary development files (not part of the project)
scratch/
.scratch/

# OS files
.DS_Store
Thumbs.db
