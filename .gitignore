# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebooks
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Project specific ignores
# Ignore raw datasets and temporary execution logs
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

data/features/*
!data/features/.gitkeep

# Models are tracked for academic reproducibility and collaborator access
# models/* (Unignored to allow model weights and TFLite binaries on GitHub)

logs/*
!logs/.gitkeep
!logs/README.md

# Scratch / temporary development files (not part of the project)
scratch/
.scratch/

# OS files
.DS_Store
Thumbs.db
